<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kalkulator 3D Kuning Responsif</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: radial-gradient(circle at center, #1e293b, #0f172a);
      padding: 20px;
    }

    /* Outer 3D Container Kalkulator */
    .calculator {
      width: 100%;
      max-width: 380px;
      background: linear-gradient(145deg, #fbbf24, #d97706);
      border-radius: 28px;
      padding: 24px;
      box-shadow: 
        0 12px 0 #92400e,
        0 20px 30px rgba(0, 0, 0, 0.4),
        inset 0 2px 3px rgba(255, 255, 255, 0.6);
      border: 2px solid #fef08a;
      position: relative;
    }

    /* Screen / Display 3D */
    .display-container {
      background: #0f172a;
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 24px;
      box-shadow: 
        inset 0 5px 10px rgba(0, 0, 0, 0.7),
        0 2px 0 rgba(255, 255, 255, 0.2);
      border: 3px solid #78350f;
    }

    .previous-operand {
      color: #94a3b8;
      font-size: 1.1rem;
      min-height: 1.4rem;
      text-align: right;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .current-operand {
      color: #fde047;
      font-size: 2.3rem;
      font-weight: 700;
      text-align: right;
      word-break: break-all;
      text-shadow: 0 0 10px rgba(253, 224, 71, 0.3);
      margin-top: 5px;
    }

    /* Buttons Grid Layout */
    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    /* Base 3D Button Style */
    button {
      height: 64px;
      border-radius: 16px;
      border: none;
      outline: none;
      font-size: 1.35rem;
      font-weight: 700;
      cursor: pointer;
      user-select: none;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: all 0.08s ease;
      -webkit-tap-highlight-color: transparent;
      position: relative;
    }

    /* Angka Buttons (Kuning Muda 3D) */
    .btn-num {
      background: linear-gradient(180deg, #fffbeb, #fef3c7);
      color: #78350f;
      box-shadow: 
        0 6px 0 #d97706,
        0 8px 12px rgba(0, 0, 0, 0.2);
    }

    .btn-num:hover {
      background: linear-gradient(180deg, #ffffff, #fef9c3);
    }

    .btn-num:active {
      transform: translateY(4px);
      box-shadow: 
        0 2px 0 #d97706,
        0 3px 6px rgba(0, 0, 0, 0.2);
    }

    /* Operator Buttons (Kuning Emas Tua 3D) */
    .btn-op {
      background: linear-gradient(180deg, #f59e0b, #d97706);
      color: #ffffff;
      box-shadow: 
        0 6px 0 #92400e,
        0 8px 12px rgba(0, 0, 0, 0.25);
    }

    .btn-op:hover {
      background: linear-gradient(180deg, #fbbf24, #f59e0b);
    }

    .btn-op:active {
      transform: translateY(4px);
      box-shadow: 
        0 2px 0 #92400e,
        0 3px 6px rgba(0, 0, 0, 0.2);
    }

    /* Clear / Delete Buttons (Merah 3D) */
    .btn-action {
      background: linear-gradient(180deg, #ef4444, #dc2626);
      color: #ffffff;
      box-shadow: 
        0 6px 0 #991b1b,
        0 8px 12px rgba(0, 0, 0, 0.25);
    }

    .btn-action:hover {
      background: linear-gradient(180deg, #f87171, #ef4444);
    }

    .btn-action:active {
      transform: translateY(4px);
      box-shadow: 
        0 2px 0 #991b1b,
        0 3px 6px rgba(0, 0, 0, 0.2);
    }

    /* Delete Button dengan Logo Icon Backspace */
    .btn-del svg {
      width: 26px;
      height: 26px;
      fill: #ffffff;
      filter: drop-shadow(0 1px 1px rgba(0,0,0,0.3));
    }

    /* Sama Dengan (=) Button */
    .btn-equal {
      background: linear-gradient(180deg, #10b981, #059669);
      color: #ffffff;
      grid-column: span 2;
      box-shadow: 
        0 6px 0 #047857,
        0 8px 12px rgba(0, 0, 0, 0.25);
    }

    .btn-equal:hover {
      background: linear-gradient(180deg, #34d399, #10b981);
    }

    .btn-equal:active {
      transform: translateY(4px);
      box-shadow: 
        0 2px 0 #047857,
        0 3px 6px rgba(0, 0, 0, 0.2);
    }

    /* Responsive adjustment untuk Tablet & Layar Kecil */
    @media (max-width: 480px) {
      .calculator {
        padding: 18px;
        border-radius: 22px;
      }

      button {
        height: 56px;
        font-size: 1.2rem;
        border-radius: 12px;
      }

      .btn-del svg {
        width: 22px;
        height: 22px;
      }

      .current-operand {
        font-size: 1.9rem;
      }
    }
  </style>
</head>
<body>

  <div class="calculator">
    <!-- Display -->
    <div class="display-container">
      <div class="previous-operand" id="previous-operand"></div>
      <div class="current-operand" id="current-operand">0</div>
    </div>

    <!-- Tombol-tombol -->
    <div class="buttons">
      <button class="btn-action" onclick="clearAll()">AC</button>
      <button class="btn-action btn-del" onclick="deleteNumber()" title="Hapus">
        <!-- Logo Backspace / Delete Icon SVG -->
        <svg viewBox="0 0 24 24">
          <path d="M22 3H7c-.69 0-1.23.35-1.59.88L0 12l5.41 8.11c.36.53.9.89 1.59.89h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-3 12.59L17.59 17 14 13.41 10.41 17 9 15.59 12.59 12 9 8.41 10.41 7 14 10.59 17.59 7 19 8.41 15.41 12 19 15.59z"/>
        </svg>
      </button>
      <button class="btn-op" onclick="appendOperator('%')">%</button>
      <button class="btn-op" onclick="appendOperator('÷')">÷</button>

      <button class="btn-num" onclick="appendNumber('7')">7</button>
      <button class="btn-num" onclick="appendNumber('8')">8</button>
      <button class="btn-num" onclick="appendNumber('9')">9</button>
      <button class="btn-op" onclick="appendOperator('×')">×</button>

      <button class="btn-num" onclick="appendNumber('4')">4</button>
      <button class="btn-num" onclick="appendNumber('5')">5</button>
      <button class="btn-num" onclick="appendNumber('6')">6</button>
      <button class="btn-op" onclick="appendOperator('-')">-</button>

      <button class="btn-num" onclick="appendNumber('1')">1</button>
      <button class="btn-num" onclick="appendNumber('2')">2</button>
      <button class="btn-num" onclick="appendNumber('3')">3</button>
      <button class="btn-op" onclick="appendOperator('+')">+</button>

      <button class="btn-num" onclick="appendNumber('0')">0</button>
      <button class="btn-num" onclick="appendNumber('.')">.</button>
      <button class="btn-equal" onclick="compute()">=</button>
    </div>
  </div>

  <script>
    let currentOperand = '0';
    let previousOperand = '';
    let operation = null;
    let resetScreen = false;

    const currentDisplay = document.getElementById('current-operand');
    const previousDisplay = document.getElementById('previous-operand');

    function updateDisplay() {
      currentDisplay.innerText = currentOperand;
      if (operation != null) {
        previousDisplay.innerText = `${previousOperand} ${operation}`;
      } else {
        previousDisplay.innerText = '';
      }
    }

    function appendNumber(number) {
      if (currentOperand === 'Error') clearAll();
      if (number === '.' && currentOperand.includes('.')) return;
      if (currentOperand === '0' && number !== '.') {
        currentOperand = number;
      } else if (resetScreen) {
        currentOperand = number;
        resetScreen = false;
      } else {
        currentOperand += number;
      }
      updateDisplay();
    }

    function appendOperator(op) {
      if (currentOperand === 'Error') return;
      if (operation !== null && !resetScreen) {
        compute();
      }
      operation = op;
      previousOperand = currentOperand;
      resetScreen = true;
      updateDisplay();
    }

    function compute() {
      let computation;
      const prev = parseFloat(previousOperand);
      const current = parseFloat(currentOperand);

      if (isNaN(prev) || isNaN(current)) return;

      switch (operation) {
        case '+':
          computation = prev + current;
          break;
        case '-':
          computation = prev - current;
          break;
        case '×':
          computation = prev * current;
          break;
        case '÷':
          if (current === 0) {
            currentOperand = 'Error';
            previousOperand = '';
            operation = null;
            updateDisplay();
            return;
          }
          computation = prev / current;
          break;
        case '%':
          computation = prev % current;
          break;
        default:
          return;
      }

      // Menghindari bug floating point javascript (misal: 0.1 + 0.2)
      currentOperand = Math.round(computation * 1e10) / 1e10;
      currentOperand = currentOperand.toString();
      operation = null;
      previousOperand = '';
      resetScreen = true;
      updateDisplay();
    }

    function clearAll() {
      currentOperand = '0';
      previousOperand = '';
      operation = null;
      resetScreen = false;
      updateDisplay();
    }

    function deleteNumber() {
      if (currentOperand === 'Error') {
        clearAll();
        return;
      }
      if (resetScreen) return;
      if (currentOperand.length === 1) {
        currentOperand = '0';
      } else {
        currentOperand = currentOperand.slice(0, -1);
      }
      updateDisplay();
    }

    // Dukungan Keyboard PC / Laptop
    window.addEventListener('keydown', (e) => {
      if ((e.key >= '0' && e.key <= '9') || e.key === '.') appendNumber(e.key);
      if (e.key === '+') appendOperator('+');
      if (e.key === '-') appendOperator('-');
      if (e.key === '*') appendOperator('×');
      if (e.key === '/') {
        e.preventDefault();
        appendOperator('÷');
      }
      if (e.key === '%') appendOperator('%');
      if (e.key === 'Enter' || e.key === '=') {
        e.preventDefault();
        compute();
      }
      if (e.key === 'Backspace') deleteNumber();
      if (e.key === 'Escape' || e.key.toLowerCase() === 'c') clearAll();
    });
  </script>
</body>
</html>
